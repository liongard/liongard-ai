":"VALIDATED"},{"seq":"P022","id":"metrics:sonicwall:wan-allow-rules-for-management-count","name":"WAN Allow Rules Permitting Management Traffic Count","metricId":106909,"jmesPathQuery":"Firewall.AccessRulesIPv4[?From=='WAN' && Action=='allow' && ((ServiceName != null && contains(ServiceName, 'Management')) || ServiceAny==True)] | length(@)","resultType":"integer","okWhen":"result == 0","gotcha":null,"status":"VALIDATED"},{"seq":"P023","id":"metrics:sonicwall:wan-to-lan-explicit-allow-any-list","name":"Explicit Allow Any WAN-to-LAN Rules","metricId":1135,"jmesPathQuery":"[Firewall.AccessRulesIPv4[?From == `WAN` && To == `LAN` && Action == `allow` && SourceAddressAny && DestinationAddressAny && Enable], Firewall.AccessRulesIPv6[?From == `WAN` && To == `LAN` && Action == `allow` && SourceAddressAny && DestinationAddressAny && Enable]][].Name","resultType":"array","okWhen":"result == []","gotcha":null,"status":"VALIDATED"},{"seq":"P024","id":"metrics:sonicwall:zones-without-gav-count","name":"Zones With Gateway Anti-Virus Disabled Count","metricId":106915,"jmesPathQuery":"Network.Zones[?GatewayAntiVirus==False] | length(@)","resultType":"integer","okWhen":"result == 0","gotcha":null,"status":"VALIDATED"},{"seq":"P025","id":"metrics:sonicwall:zones-without-ips-count","name":"Zones Without Intrusion Prevention Count","metricId":703,"jmesPathQuery":"length(Network.Zones[?IntrusionPrevention ==`false`])","resultType":"integer","okWhen":"result == 0","gotcha":"IntrusionPrevention is boolean False (not string 'false') — the Global metric uses backtick `false` which is JSON false in JMESPath. The id=106916 variant uses `Network.Zones[?IntrusionPrevention==False]` (Python-style) and also returns a valid result. Use backtick-quoted boolean for strict JMESPath compliance.","status":"VALIDATED"},{"seq":"P026","id":"metrics:sonicwall:zones-without-ips-list","name":"Zones Without Intrusion Prevention List","metricId":702,"jmesPathQuery":"Network.Zones[?IntrusionPrevention  == `fals