    "liongard_device": "Reconciled device inventory across inspectors.",
    "liongard_identity": "Reconciled identity/user inventory across inspectors.",
    "liongard_domain": "Reconciled domain inventory.",
    "liongard_timeline": "Change history for a system over time.",
